# Copy to .env.local and fill from Firebase console → Project settings → Your apps → Web app.
# These values are not secrets (they ship to the browser); access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# The business name shown in the header, browser tab and installed app.
VITE_APP_NAME=Family Research

# Set to true (or use `npm run dev:emu`) to talk to the local Auth + Firestore emulators.
VITE_USE_EMULATORS=false
