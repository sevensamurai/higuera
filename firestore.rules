rules_version = '2';

// The Spark (free) plan has no Cloud Functions, so these rules are the whole backend:
// every invariant the client cannot be trusted with is enforced here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins are bootstrapped by hand in the console: create admins/{uid}. No client can write it.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function optionalString(data, key) {
      return !(key in data) || (data[key] is string && data[key].size() <= 64);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Public profile mirror, written by the user on sign-in so admin can pick them when assigning tasks.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'lastLoginAt', 'timeZone', 'detectedTimeZone', 'locale'])
        && request.resource.data.email == request.auth.token.email
        && optionalString(request.resource.data, 'timeZone')
        && optionalString(request.resource.data, 'detectedTimeZone')
        && (!('locale' in request.resource.data) || request.resource.data.locale in ['es', 'en']);
      allow delete: if isAdmin();
    }

    // content/overview (landing copy) and content/settings (the tutor's timezone).
    // Readable by anyone, including signed-out visitors.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookable slots, generated by the admin from availability windows.
    match /slots/{slotId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // A booking request: 1–3 preferred slots; the admin confirms one.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.payment == 'pending'
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 1
        && request.resource.data.options.size() <= 3
        && request.resource.data.kind in ['tutoring', 'freelance']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && optionalString(request.resource.data, 'userTimeZone')
        && !('confirmed' in request.resource.data)
        && !('summary' in request.resource.data);

      // The owner may only withdraw a request that has not been confirmed yet.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && onlyChanges(['status', 'updatedAt'])
      );

      allow delete: if isAdmin();

      // Session notes: a thread the tutor and this booking's student both write to.
      // Notes are append-only; authors (and the tutor) may delete, nobody edits.
      match /notes/{noteId} {
        function owner() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId;
        }
        allow read: if isAdmin() || (signedIn() && owner() == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'role', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && (
            (isAdmin() && request.resource.data.role == 'tutor')
            || (!isAdmin() && owner() == request.auth.uid && request.resource.data.role == 'student')
          );
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Homework / tasks assigned by the tutor, usually within a session. Students read their own;
    // only the tutor creates them or marks them complete.
    match /tasks/{taskId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
