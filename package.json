{
  "name": "tutor-booking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-tutor-booking",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tutor-booking \"node --test tests/rules.test.mjs\"",
    "test:unit": "node --test tests/timezone.test.ts tests/i18n.test.ts",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-tutor-booking \"bash tests/run-e2e.sh\"",
    "dev:lan": "bash scripts/dev-lan.sh"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "firebase": "^12.19.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "firebase-tools": "^15.32.1",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.12"
  }
}
